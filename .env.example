NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; optional for manual workflows
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional cloud-proxy-compatible alternative to OPENAI_API_KEY
PERMITPILOT_OPENAI_KEY=

# Explicit local-only plan workbench; disabled under NODE_ENV=production
PERMITPILOT_LOCAL_REVIEW=0
# Private Codespaces evaluation uses scripts/codespaces-start.sh; it verifies
# real provider metadata and Private port visibility before enabling sessions.
# These flags alone do not establish authentication. Do not expose port 3000.
PERMITPILOT_CODESPACES_REVIEW=0
# Optional; defaults to .permitpilot in the checkout (private, gitignored)
PERMITPILOT_DATA_DIR=
# Interpreter with processor/requirements.txt installed
PERMITPILOT_PYTHON=python
# Optional actual baseline path for e2e (not a fabricated fixture)
PERMITPILOT_TEST_PDF=
